#!/usr/bin/env bash
set -euo pipefail

speckit_root="$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
speckit_cli="$speckit_root/.tools/spec-kit/bin/specify"
if [[ ! -x "$speckit_cli" ]]; then
  printf '%s\n' 'Falta la CLI local. Ejecuta: bash scripts/setup-spec-kit.sh' >&2
  exit 1
fi
exec "$speckit_cli" "$@"
