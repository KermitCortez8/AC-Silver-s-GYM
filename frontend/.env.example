VITE_APP_NAME=AC Silver's GYM
# Mismo ID de aplicación web configurado como GOOGLE_CLIENT_ID en backend/.env.
VITE_GOOGLE_CLIENT_ID=
# Local: /api usa el proxy de Vite. En Vercel configurar la URL HTTPS completa:
# VITE_AUTH_API_BASE_URL=https://ac-silvers-gym-api-review.onrender.com/api
VITE_AUTH_API_BASE_URL=/api
# Solo para npm run dev; no se utiliza en el despliegue estático de Vercel.
VITE_BACKEND_URL=http://localhost:8000
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=pon-tu-clave-publica-anon-aqui
VITE_SUPABASE_LANDING_BUCKET=imageneslandingpage
VITE_SUPABASE_LANDING_FOLDER=landingpage
# Vercel: Root Directory = frontend. Cargar estas variables públicas en el panel.
# Las variables VITE_ son visibles en el navegador; nunca colocar secretos aquí.
