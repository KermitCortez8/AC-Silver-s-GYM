SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=pon-tu-service-role-key-aqui
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxx
STRIPE_MODE=test
FRONTEND_PUBLIC_URL=http://localhost:5173

# Google Auth Platform > Clientes > Aplicación web (no es el client secret).
GOOGLE_CLIENT_ID=
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Clave privada del gimnasio para firmar sesiones. Nunca usar prefijo VITE_.
AUTH_SECRET_KEY=

# Cuenta Gmail del gimnasio: pagos, activaciones y confirmación inmediata de matrícula.
# Los recordatorios usan estos mismos valores en Supabase > Edge Functions > Secrets.
GMAIL_EMAIL=
# Google > Seguridad > Verificación en dos pasos > Contraseñas de aplicaciones.
# https://myaccount.google.com/apppasswords (16 caracteres, nunca en el frontend).
GMAIL_APP_PASSWORD=
# Opcional: nombre que ve el destinatario junto al correo remitente.
EMAIL_FROM_NAME=Silver Gym Surco
